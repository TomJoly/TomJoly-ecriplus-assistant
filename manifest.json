{\n  "manifest_version": 3,\n  "name": "Ecri+ Assistant",\n  "version": "1.0.0",\n  "description": "Assistant IA pour analyser les questions ecri+ avec un LLM",\n  "permissions": [\n    "activeTab",\n    "storage"\n  ],\n  "host_permissions": [\n    "https://*.ecriplus.fr/*"\n  ],\n  "action": {\n    "default_popup": "popup/popup.html",\n    "default_title": "Ecri+ Assistant"\n  },\n  "content_scripts": [\n    {\n      "matches": ["https://*.ecriplus.fr/*"],\n      "js": ["content/content.js"],\n      "css": ["content/content.css"]\n    }\n  ],\n  "background": {\n    "service_worker": "background/background.js"\n  }\n}