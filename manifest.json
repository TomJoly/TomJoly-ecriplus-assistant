{"manifest_version": 3,
  "name": "Ecri+ Assistant",
  "version": "1.0.0",
  "description": "Assistant IA pour analyser les questions ecri+ avec un LLM",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*.ecriplus.fr/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.ecriplus.fr/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"]
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  } }